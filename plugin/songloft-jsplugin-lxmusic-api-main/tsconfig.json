{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": ".",
    "rootDir": "src",
    "declaration": false,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "lib": ["ES2020"],
    "types": ["@songloft/plugin-sdk"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
